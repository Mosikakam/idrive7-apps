{
  "schema": 1,
  "components": [
    {
      "id": "bmw_weather",
      "kind": "app",
      "path": "apps/bmw_weather",
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "build": {
        "python": "kit/tools/build.py",
        "args": [
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "shared": [
          "kit/runtime",
          "kit/platform",
          "kit/localization",
          "kit/tools/build.py",
          "kit/tools/pack_data.py",
          "kit/tools/localize.py",
          "kit/tools/locale-revisions.json",
          "kit/tools/oapgen",
          "oap-sdk"
        ]
      }
    }
  ]
}
